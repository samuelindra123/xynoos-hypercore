---
import BrandMark from "./BrandMark.astro";
import { repository, sections, sitePath } from "../lib/site";

interface Props {
  section?: (typeof sections)[number]["slug"];
}
const { section } = Astro.props;
const pages = [{ slug: "", name: "Home" }, ...sections];
---

<div class="ambient-scene" aria-hidden="true">
  <div class="ambient-light"></div>
  <div class="ambient-grid"></div>
</div>
{!section && <div class="reading-progress" aria-hidden="true"></div>}
<a class="site-skip" href="#main">Skip to content</a>

<header class="site-header site-width">
  <a class="site-brand" href={sitePath()} aria-label="Xynoos Studio home">
    <BrandMark />XYNOOS<span>/ STUDIO</span>
  </a>

  {[false, true].map((mobile) => (
    <nav
      class:list={["site-nav", { "site-nav-mobile": mobile }]}
      id={mobile ? "site-menu" : undefined}
      popover={mobile ? "auto" : undefined}
      aria-label="Main navigation"
    >
      {pages.map(({ slug, name }) => (
        <a href={sitePath(slug)} aria-current={(section ?? "") === slug ? "page" : undefined}>{name}</a>
      ))}
      <a class="site-repository" href={repository}>GitHub</a>
    </nav>
  ))}

  <div class:list={["site-tools", { "site-tools-compact": section }]}>
    {!section && (
      <button class="motion-control" type="button" aria-pressed="false" aria-label="Pause decorative motion">
        Motion <span>on</span>
      </button>
    )}
    <button type="button" class="site-menu-toggle" popovertarget="site-menu">Menu</button>
  </div>
</header>

<style>
  .site-skip {
    position: absolute;
    top: .75rem;
    left: 1rem;
    z-index: 30;
    transform: translateY(-200%);
    padding: .7rem 1rem;
    background: var(--warm);
    color: var(--canvas);
  }
  .site-skip:focus { transform: translateY(0); }
  .site-header {
    display: flex;
    position: relative;
    z-index: 10;
    align-items: center;
    justify-content: space-between;
    gap: clamp(.6rem, 1.25vw, 1.35rem);
    height: 96px;
    border-bottom: 1px solid #ffffff10;
  }
  .site-brand {
    font-size: 1.15rem;
    white-space: nowrap;
  }
  .site-brand span {
    margin-left: .15rem;
    padding-left: .65rem;
    border-left: 1px solid #4b3b37;
    font: .625rem "Courier New", monospace;
    color: #b7a9af;
    letter-spacing: .12em;
  }
  .site-nav {
    display: flex;
    position: static;
    align-items: center;
    gap: clamp(.45rem, 1.3vw, 1.35rem);
  }
  .site-nav a {
    display: flex;
    align-items: center;
    min-height: 40px;
    color: var(--ink);
    font: 700 .875rem/1.3 "Manrope", Arial, sans-serif;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a::after { content: none; }
  .site-nav a:hover, .site-nav a[aria-current] { color: var(--warm); }
  .site-nav a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .42em;
  }
  .site-repository,
  .site-menu-toggle {
    border: 1px solid #79503d;
    border-radius: 4px;
    padding: .48rem .75rem;
    color: var(--warm);
    background: #ffad7410;
  }
  .site-repository:hover, .site-menu-toggle:hover { border-color: var(--accent); }
  .site-tools { display: flex; align-items: center; gap: .7rem; }
  .site-tools-compact, .site-menu-toggle, .site-nav-mobile { display: none; }
  .site-tools .motion-control { white-space: nowrap; color: #b6aab1; }
  .site-tools .motion-control:disabled { opacity: .7; }
  @media (max-width: 1280px) {
    .site-brand span { display: none; }
  }
  @media (max-width: 1080px) {
    .site-brand span { display: inline; }
    .site-nav:not(.site-nav-mobile) { display: none; }
    .site-tools-compact { display: flex; }
    .site-menu-toggle { display: inline-block; min-height: 42px; font: 700 .875rem "Manrope", Arial, sans-serif; cursor: pointer; }
    .site-nav-mobile:popover-open {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      position: absolute;
      inset: 82px 0 auto;
      width: min(420px, calc(100% - 40px));
      margin: 0 max(20px, 4vw) 0 auto;
      gap: .25rem .8rem;
      padding: .85rem;
      border: 1px solid #79503d;
      border-radius: 6px;
      color: var(--ink);
      background: #18151d;
      box-shadow: 0 18px 40px #0008;
    }
    .site-nav-mobile a { padding-inline: .55rem; white-space: normal; overflow-wrap: anywhere; }
  }
  @media (max-width: 850px) {
    .site-header { height: 84px; }
    .site-nav-mobile:popover-open { top: 72px; }
  }
  @media (max-width: 650px) {
    .site-header { height: 76px; }
    .site-nav-mobile:popover-open { top: 64px; }
    .site-brand { font-size: 1rem; }
  }
  @media (max-width: 390px) {
    .site-brand span { display: none; }
  }
</style>
