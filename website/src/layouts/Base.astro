---
import "../styles/fonts.css";
import "../styles/studio-theme.css";
import "../styles/studio.css";
import "../styles/film.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Xynoos Studio — Experimental Linux resource intelligence",
  description = "Xynoos HyperCore is an experimental Linux resource intelligence engine built primarily in Rust. Explore telemetry, policy research and bounded memory experiments.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = "https://website-xybc.vercel.app";
const canonicalPath = "/";
const canonical = new URL(canonicalPath, site);
const socialImage = new URL(
  `${base}media/studio-social.jpg`,
  site,
);
const socialDescription =
  "Built primarily in Rust. Telemetry, policy research and bounded memory experiments. Experimental; not production-ready.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d11" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}branding/mark.svg`} type="image/svg+xml" />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xynoos HyperCore" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta
      property="og:image:alt"
      content="Xynoos Studio: editorial typography and a layered, illuminated X-shaped architecture instrument"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
  </head>
  <body>
    <slot />
    <script src="../scripts/studio.js"></script>
  </body>
</html>
