[Unit]
Description=XYNOOS HyperCore Autonomous Memory & Resource Optimization Daemon
Documentation=https://github.com/samuelindra123/xynoos-hypercore
After=network.target local-fs.target
PartOf=xynoos-hypercore.slice

[Service]
Type=simple
EnvironmentFile=-/etc/default/xynoos-hypercore
RuntimeDirectory=xynoos
RuntimeDirectoryMode=0755
StateDirectory=xynoos
StateDirectoryMode=0755
ExecStart=/usr/bin/xynoos daemon --mode ${XYNOOS_MODE} --interval-ms ${XYNOOS_INTERVAL_MS}
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
Slice=xynoos-hypercore.slice

# Sandboxing & Hardening Invariants
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=false
ReadWritePaths=/var/lib/xynoos /run/xynoos
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_NETLINK
MemoryHigh=32M
MemoryMax=64M
TasksMax=16
CPUWeight=100
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
